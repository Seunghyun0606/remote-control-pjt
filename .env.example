# Set this to an absolute directory for stable DB/config paths across launch directories.
# Windows example: REMOTE_CONTROL_HOME=C:/Users/you/remote-control-pjt
# Linux example: REMOTE_CONTROL_HOME=/home/ubuntu/remote-control-pjt
REMOTE_CONTROL_HOME=
REMOTE_CONTROL_DB_URL=sqlite+aiosqlite:///./remote-control.db
REMOTE_CONTROL_CONFIG=./config/projects.yaml
REMOTE_CONTROL_HOST_ID=lightsail-main
REMOTE_CONTROL_API_HOST=127.0.0.1
REMOTE_CONTROL_API_PORT=8787
REMOTE_CONTROL_HEARTBEAT_TIMEOUT_SECONDS=45
REMOTE_CONTROL_PROGRESS_INTERVAL_SECONDS=300
REMOTE_CONTROL_SCHEDULER_INTERVAL_SECONDS=15
REMOTE_CONTROL_QUOTA_RETRY_INITIAL_SECONDS=1800
REMOTE_CONTROL_QUOTA_RETRY_MAX_SECONDS=7200
REMOTE_CONTROL_QUOTA_RESET_GRACE_SECONDS=600
REMOTE_CONTROL_RESTART_GRACE_SECONDS=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

REMOTE_CONTROL_SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USER_IDS=
REMOTE_CONTROL_WEB_UI_ENABLED=true

CONTROLLER_RUNNER_TOKEN=change-me
# Required when REMOTE_CONTROL_API_HOST is not loopback.
CONTROLLER_API_TOKEN=

CODEX_EXECUTABLE=codex
# Set this to the same Codex home used by interactive Desktop Codex when sharing threads.
# Windows example: CODEX_HOME=C:/Users/you/.codex
CODEX_HOME=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
PROJECTCTL_EXECUTABLE=projectctl
GIT_EXECUTABLE=git
REMOTE_CONTROL_PROJECT_OPERATION_TIMEOUT_SECONDS=30

REMOTE_RUNNER_CONTROLLER_WS=ws://127.0.0.1:8787/ws/runner
REMOTE_RUNNER_TOKEN=
REMOTE_RUNNER_HOST_ID=desktop-main
REMOTE_RUNNER_NAME=Desktop Runner
REMOTE_RUNNER_OS=
REMOTE_RUNNER_CAPABILITIES=codex,git,projectctl,android,gui,browser
REMOTE_RUNNER_HEARTBEAT_SECONDS=15
REMOTE_RUNNER_RECONNECT_SECONDS=5
